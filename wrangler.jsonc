// The top level is a template for your own deployment: every value marked REPLACE is yours to set
// before `pnpm run deploy`. docs/self-hosting.md goes through each setting. The environment
// `cloud` at the end is Gateweave Cloud's own deployment of the same code (status.gateweave.com).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "status",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// Wrangler uses the account you are logged in to, or CLOUDFLARE_ACCOUNT_ID. In your own copy
	// you may add "account_id" to pin it; this public file never names an account.
	"workers_dev": false,
	// The page's address. REPLACE with a hostname on a zone in your account. A Worker on a Custom
	// Domain of the same zone as a checked service can fetch it; one on a route can't.
	"routes": [{ "pattern": "status.example.com", "custom_domain": true }],
	"observability": { "enabled": true },
	// Every minute: check each service, keep the result, open or close incidents, send alerts.
	"triggers": { "crons": ["* * * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "status",
			// REPLACE with the id `npx wrangler d1 create status` prints.
			"database_id": "REPLACE-WITH-DATABASE-ID",
			"migrations_dir": "migrations"
		}
	],
	// Email alerts need Cloudflare Email Sending on your domain. REPLACE with the address alerts
	// come from, here and in ALERT_FROM below.
	"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["status@example.com"] }],
	"vars": {
		// What is checked, in the order the page shows it. A service is up when its URL answers
		// `expect` (200 by default) within 10 seconds, with `contains` in the body when that is set.
		// `team` is a Track team's key, for incident issues. REPLACE these examples.
		"SERVICES": [
			{ "id": "site", "name": "Website", "url": "https://example.com/" },
			{
				"id": "api",
				"name": "API",
				"url": "https://api.example.com/health",
				"contains": "\"ok\":true"
			}
		],
		// What the page and the messages call themselves. All are optional; without them the page
		// is called "Status" and carries no link. PAGE_URL is the page's own address (alerts and
		// issues link to it, and the checks' user agent names it); HOME_URL is where the heading
		// and footer link.
		// "PAGE_NAME": "Example Status",
		// "PAGE_DESCRIPTION": "Whether Example's services are working, and their last 90 days.",
		// "PAGE_URL": "https://status.example.com",
		// "HOME_URL": "https://example.com",
		// Alerts go from this address to the secret ALERT_TO (one address or a comma-separated
		// list). Without ALERT_TO, incidents are only shown on the page.
		"ALERT_FROM": "Status <status@example.com>"
		// The error watch: every 15 minutes, how often these hosts answered 5xx and these Workers
		// and their Durable Objects failed, from Cloudflare's analytics, with the secret
		// ANALYTICS_TOKEN (Account Analytics Read on the account, Analytics Read on the zone). It
		// alerts at `minErrors` errors and `minShare` of the requests in a window, and not again for
		// a service within six hours. Off until this is set.
		// "ERROR_WATCH": {
		// 	// Or leave these two out and set the secrets ERROR_WATCH_ACCOUNT and ERROR_WATCH_ZONE.
		// 	"account": "<your account id>",
		// 	"zone": "<your zone id>",
		// 	"hosts": ["example.com", "api.example.com"],
		// 	"scripts": ["my-site-worker"],
		// 	"minErrors": 10,
		// 	"minShare": 0.05
		// },
		// Each incident can also be filed as an issue in Track (src/track.ts), with a comment when
		// it ends. Set all of TRACK_URL, TRACK_WORKSPACE and TRACK_TEAM, TRACK_LABELS if the issues
		// get labels, and the secret TRACK_KEY (an agent member's key). Without them nothing is filed.
		// "TRACK_URL": "https://track.example.com",
		// "TRACK_WORKSPACE": "my-workspace",
		// "TRACK_TEAM": "OPS",
		// "TRACK_LABELS": "Operations",
	},
	// Gateweave's own deployment (`pnpm run deploy:cloud`) follows the convention of Track and Forms:
	// this public file names the environment, its Worker, its custom domain and its database's id (the
	// id of a resource, which grants nothing), and nothing that names the account or a zone. The
	// account is CLOUDFLARE_ACCOUNT_ID in the environment; Cloudflare finds the zone from the custom
	// domain. The error watch's two ids are the secrets ERROR_WATCH_ACCOUNT and ERROR_WATCH_ZONE.
	// Wrangler inherits "routes", "triggers", "observability" and "workers_dev" into an environment,
	// and derives its name as "<name>-cloud" ("status-cloud", a second Worker), so `cloud` states its
	// own "name" and "routes" and repeats the other settings. It does not inherit vars and bindings
	// (D1, send_email), so it repeats those too.
	// `pnpm run deploy:cloud` refuses to deploy unless the live Worker has both error watch secrets.
	"env": {
		"cloud": {
			"name": "gateweave-status",
			"workers_dev": false,
			"routes": [{ "pattern": "status.gateweave.com", "custom_domain": true }],
			"observability": { "enabled": true },
			"triggers": { "crons": ["* * * * *"] },
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "gateweave-status",
					"database_id": "7eeb52c7-07c8-453f-84d7-f1f2b214c1ec",
					"migrations_dir": "migrations"
				}
			],
			"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["status@gateweave.com"] }],
			"vars": {
				"PAGE_NAME": "Gateweave Status",
				"PAGE_DESCRIPTION": "Whether Gateweave's services are working, checked every minute, and their last 90 days.",
				"PAGE_URL": "https://status.gateweave.com",
				"HOME_URL": "https://gateweave.com",
				"SERVICES": [
					{ "id": "site", "name": "Website", "url": "https://gateweave.com/" },
					{
						"id": "id",
						"name": "ID",
						"team": "ID",
						"url": "https://id.gateweave.com/api/auth/jwks",
						"contains": "\"keys\""
					},
					{
						"id": "track",
						"name": "Track",
						"team": "TRK",
						"url": "https://track.gateweave.com/api/auth/ok",
						"contains": "\"ok\":true"
					},
					{
						"id": "agents",
						"name": "Agents",
						"team": "AGT",
						"url": "https://agents.gateweave.com/api/auth/ok",
						"contains": "\"ok\":true"
					},
					{
						"id": "guard",
						"name": "Guard",
						"team": "GRD",
						"url": "https://guard.gateweave.com/api/auth/ok",
						"contains": "\"ok\":true"
					},
					{
						"id": "mail",
						"name": "Mail",
						"team": "MAIL",
						"url": "https://mail.gateweave.com/api/auth/ok",
						"contains": "\"ok\":true"
					},
					{
						"id": "growth",
						"name": "Growth",
						"team": "MMO",
						"url": "https://growth.gateweave.com/health",
						"contains": "\"ok\":true"
					},
					{
						"id": "track-demo",
						"name": "Track demo",
						"team": "TRK",
						"url": "https://track-demo.gateweave.com/api/auth/ok",
						"contains": "\"ok\":true"
					}
				],
				// Without `account` and `zone`: those come from the secrets named above.
				"ERROR_WATCH": {
					"hosts": [
						"gateweave.com",
						"id.gateweave.com",
						"track.gateweave.com",
						"agents.gateweave.com",
						"guard.gateweave.com",
						"mail.gateweave.com",
						"growth.gateweave.com",
						"track-demo.gateweave.com",
						"pkg.gateweave.com",
						"status.gateweave.com"
					],
					"scripts": [
						"gateweave-site",
						"gateweave-id",
						"gateweave-track",
						"gateweave-agents",
						"gateweave-guard",
						// Mail's production Worker: its `cloud` environment has a name of its own.
						"gateweave-mail-cloud",
						"gateweave-growth",
						"gateweave-track-demo",
						"gateweave-backup",
						"gateweave-status"
					],
					"minErrors": 10,
					"minShare": 0.05
				},
				// Incidents go to Gateweave's own Track workspace, as the agent member "Status": each
				// product's to its own team (`team` on a service above), the website's to TRACK_TEAM.
				"TRACK_URL": "https://track.gateweave.com",
				"TRACK_WORKSPACE": "gateweave",
				"TRACK_TEAM": "WEB",
				"TRACK_LABELS": "Operations",
				"ALERT_FROM": "Gateweave Status <status@gateweave.com>"
			}
		}
	}
}
